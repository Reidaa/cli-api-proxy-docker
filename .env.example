# CLIProxyAPI release used to build the image.
CLI_PROXY_VERSION=7.2.121

# Keep 127.0.0.1 unless the proxy must be reachable from another machine.
# install.sh --tailscale sets this to the host's Tailscale address instead,
# binding every published port to the tailnet only.
BIND_ADDRESS=127.0.0.1
CLI_PROXY_PORT=8317
TZ=UTC

# install.sh writes the current user's IDs here for bind-mount permissions.
HOST_UID=1000
HOST_GID=1000

# install.sh resolves and writes these three paths when it generates .env.
# They are host bind sources for the XDG directories:
#   CLI_PROXY_CONFIG_DIR  $XDG_CONFIG_HOME/cli-api-proxy  (default ~/.config/...)
#   CLI_PROXY_DATA_DIR    $XDG_DATA_HOME/cli-api-proxy    (default ~/.local/share/...)
#   CLI_PROXY_STATE_DIR   $XDG_STATE_HOME/cli-api-proxy   (default ~/.local/state/...)
# This example file does not set them: copying it verbatim would mount the
# wrong paths. Always run install.sh to produce a real .env.
