# This file is used by install.sh. Keep the __...__ values unchanged in this example.
host: ""
port: 8317

tls:
  enable: false
  cert: ""
  key: ""

# The container receives host traffic through a Docker network, so management
# access must be remote from the application's point of view. The Compose file
# binds all ports to 127.0.0.1 by default.
remote-management:
  allow-remote: __ALLOW_REMOTE_MANAGEMENT__
  secret-key: "__MANAGEMENT_SECRET__"
  disable-control-panel: false
  panel-github-repository: "https://github.com/router-for-me/Cli-Proxy-API-Management-Center"

auth-dir: "/data/auths"

# Add client API keys here if the proxy must require authentication.
api-keys: []

debug: false
# Write rotating log files to /data/logs. The total size cap deletes the oldest
# files first; upstream's default of 0 means unlimited growth.
logging-to-file: true
logs-max-total-size-mb: 256
usage-statistics-enabled: true
proxy-url: ""
request-retry: 3
max-retry-interval: 30

quota-exceeded:
  switch-project: true
  switch-preview-model: true

routing:
  strategy: "round-robin"
  session-affinity: false

ws-auth: true

plugins:
  enabled: false
  dir: "/data/plugins"
  configs: {}

# Add API-key providers here, or use the management UI and OAuth login flows.
# See upstream's complete example for all options:
# https://github.com/router-for-me/CLIProxyAPI/blob/main/config.example.yaml
